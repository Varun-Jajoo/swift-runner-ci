                            <constraint firstItem="spr003" firstAttribute="leading" secondItem="spr002" secondAttribute="leading" id="spr061"/>
                            <constraint firstAttribute="trailing" secondItem="spr003" secondAttribute="trailing" id="spr062"/>
                            <constraint firstAttribute="bottom" secondItem="spr003" secondAttribute="bottom" id="spr063"/>
                        </constraints>
                    </view>
