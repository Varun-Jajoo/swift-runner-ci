        <scene sceneID="sprScn">
            <objects>
                <viewController storyboardIdentifier="SgptPricingViewController" useStoryboardIdentifierAsRestorationIdentifier="YES" id="spr001" customClass="SgptPricingViewController" customModule="MyPT_Connect" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="spr002">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" showsHorizontalScrollIndicator="NO" translatesAutoresizingMaskIntoConstraints="NO" id="spr003">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" translatesAutoresizingMaskIntoConstraints="NO" id="spr004">
                                        <rect key="frame" x="0.0" y="0.0" width="393" height="1600"/>
                                        <subviews>
                                            <!-- Hero: the flattened Figma export (curtain glow + team photo +
                                                 "BUILT AS ONE" title baked in as one image), not hand-layered -
                                                 same lesson learned on Android after an earlier hand-built
                                                 version didn't match. -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="spr010">
                                                <rect key="frame" x="0.0" y="0.0" width="393" height="559"/>
                                                <subviews>
                                                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="sgpt-pricing-hero" translatesAutoresizingMaskIntoConstraints="NO" id="spr011">
                                                        <rect key="frame" x="0.0" y="0.0" width="393" height="559"/>
                                                    </imageView>
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="spr013" customClass="GlassCircularIconButton" customModule="MyPT_Connect" customModuleProvider="target">
                                                        <rect key="frame" x="16" y="8" width="40" height="40"/>
                                                        <state key="normal" image="chevron.left" catalog="system"/>
                                                        <color key="tintColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                        <connections>
                                                            <action selector="backTapped" destination="spr001" eventType="touchUpInside" id="spr014"/>
                                                        </connections>
                                                    </button>
                                                </subviews>
                                                <constraints>
                                                    <constraint firstItem="spr011" firstAttribute="top" secondItem="spr010" secondAttribute="top" id="spr018"/>
                                                    <constraint firstItem="spr011" firstAttribute="leading" secondItem="spr010" secondAttribute="leading" id="spr019"/>
                                                    <constraint firstAttribute="trailing" secondItem="spr011" secondAttribute="trailing" id="spr020"/>
                                                    <constraint firstAttribute="bottom" secondItem="spr010" secondAttribute="bottom" firstItem="spr011" id="spr021"/>
                                                    <!-- Aspect ratio (1951:1459, the real exported asset's native
                                                         size) is what actually gives this view a height - width
                                                         alone, edge-pinned on all 4 sides with no aspect constraint,
                                                         is an ambiguous/circular layout (container height depends on
                                                         the image, image height depends on the container). -->
                                                    <constraint firstItem="spr011" firstAttribute="height" secondItem="spr011" secondAttribute="width" multiplier="1951:1459" id="spr023"/>
                                                    <constraint firstItem="spr013" firstAttribute="top" secondItem="spr010" secondAttribute="top" constant="8" id="spr026"/>
                                                    <constraint firstItem="spr013" firstAttribute="leading" secondItem="spr010" secondAttribute="leading" constant="16" id="spr027"/>
                                                    <constraint firstItem="spr013" firstAttribute="width" constant="40" id="spr028"/>
                                                    <constraint firstItem="spr013" firstAttribute="height" constant="40" id="spr029"/>
                                                </constraints>
                                            </view>
                                            <!-- Below this point, everything (plan cards, countdown, CTA) is
                                                 built in code into this one empty container - matches
                                                 SgptSessionDetailViewController's own container-per-section
                                                 approach, and avoids hand-authoring the 3-card carousel's Auto
                                                 Layout in raw IB XML, which is the highest-risk part of this
                                                 screen. -->
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="spr040">
                                                <rect key="frame" x="0.0" y="559" width="393" height="500"/>
                                            </view>
                                        </subviews>
                                    </stackView>
                                </subviews>
